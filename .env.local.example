# Optional: use Claude instead of a local Ollama model (https://platform.claude.com/settings/keys).
# Leave empty to run analysis locally through Ollama.
ANTHROPIC_API_KEY=

# Optional: Reddit "script" app credentials (https://www.reddit.com/prefs/apps).
# Without them Reddit is read through its public RSS feeds, which return fewer comments and rate-limit sooner.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: force "ollama" or "anthropic"
LLM_PROVIDER=

# Optional: force live analysis "on" or "off" (it turns off automatically on Vercel without an API key)
LIVE_ANALYSIS=
